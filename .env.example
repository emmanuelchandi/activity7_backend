# Copy this file to .env and fill in your own values. Never upload .env to GitHub.

# Connection string of your PostgreSQL database (copy it from Render, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Websites allowed to call this API from a browser, separated by commas.
# Leave empty for now. In Activity 8 add your hosted frontend address here.
# Example: CLIENT_ORIGINS=https://timely-malabi-9a4c96.netlify.app,http://127.0.0.1:5500
CLIENT_ORIGINS=

# Shown on the API guide page
STUDENT_NUMBER=202512538

# Local port (the host sets PORT by itself when deployed)
PORT=3000
